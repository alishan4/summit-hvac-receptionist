APP_ENV=dev
LOG_LEVEL=INFO
# Public https URL Retell calls (ngrok URL locally, your domain in prod). No trailing slash.
PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# Prod (Vercel): Neon POOLED string (host contains "-pooler"), e.g.
# postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local dev/tests only: sqlite:///./summit.db (not allowed on Vercel)
DATABASE_URL=sqlite:///./summit.db
COMPANY_CONFIG_PATH=config/company.yaml
PROMPT_DIR=prompts

# --- Retell ---
# API key (must have the webhook badge) - also used to verify webhook signatures
RETELL_API_KEY=key_xxxxxxxxxxxxxxxx
# Keep true. Set false ONLY to poke tool endpoints with curl.
RETELL_VERIFY_SIGNATURE=true
RETELL_VOICE_ID=11labs-Adrian
# Optional LLM override; blank = Retell default
RETELL_LLM_MODEL=

# --- Google Calendar (backend: google | fake) ---
CALENDAR_BACKEND=google
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# Use ONE of these:
# Vercel has no secrets folder: paste the whole key JSON (one line) into GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Twilio SMS (backend: twilio | log) ---
SMS_BACKEND=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+13035550199

# --- Owner email (backend: smtp | resend | log) ---
EMAIL_BACKEND=smtp
EMAIL_FROM=receptionist@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=app-password
SMTP_STARTTLS=true
# Only if EMAIL_BACKEND=resend
RESEND_API_KEY=

# --- Demo website (the /web project talks to these endpoints) ---
# Access code the site asks for before any voice/text session starts. UNSET = /demo endpoints disabled.
DEMO_ACCESS_CODE=choose-a-code-to-share-with-prospects
# Origin(s) of the demo site (comma-separated). Only these may call /demo from a browser.
DEMO_ALLOWED_ORIGINS=https://summit-demo.vercel.app
# Printed by scripts/setup_retell_agent.py
RETELL_AGENT_ID=agent_xxxxxxxxxxxxxxxx
RETELL_CHAT_AGENT_ID=agent_xxxxxxxxxxxxxxxx
# Credit protection (defaults shown)
DEMO_MAX_CALL_SECONDS=240
DEMO_WEB_CALLS_PER_HOUR=5
DEMO_CHATS_PER_HOUR=10
DEMO_MAX_CALLS_PER_DAY=30
DEMO_MAX_CHAT_MESSAGES=30
# Real phone calls: agent max duration; a call with no end event leaves "Live" on the dashboard after this
PHONE_MAX_CALL_SECONDS=900
# White-label branding file
BRANDING_CONFIG_PATH=config/branding.yaml
